// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String          @map("password_hash")
  name          String?
  createdAt     DateTime        @default(now()) @map("created_at")
  transcriptions Transcription[]
  dictionary    Dictionary[]
  settings      UserSettings?

  @@map("users")
}

model Transcription {
  id        String   @id @default(cuid())
  text      String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("transcriptions")
  @@index([userId])
  @@index([createdAt])
}

model Dictionary {
  id           String  @id @default(cuid())
  word         String
  substitution String?
  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, word])
  @@map("dictionary")
  @@index([userId])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // AI Formatter Settings
  aiFormatterProvider   String?  @map("ai_formatter_provider") // groq, openai, local, none
  groqApiKey            String?  @map("groq_api_key") // Encrypted
  openaiApiKey          String?  @map("openai_api_key") // Encrypted
  ollamaUrl             String?  @map("ollama_url") // For local LLM
  
  // AI Formatter Options
  detectBulletPoints    Boolean  @default(true) @map("detect_bullet_points")
  refineGrammar         Boolean  @default(true) @map("refine_grammar")
  improvePunctuation    Boolean  @default(true) @map("improve_punctuation")
  improveCapitalization Boolean  @default(true) @map("improve_capitalization")
  addFormatting         Boolean  @default(true) @map("add_formatting")
  
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
  @@index([userId])
}
